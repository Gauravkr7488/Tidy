CREATE TABLE Task (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    done INTEGER AS Boolean NOT NULL DEFAULT 0,
    repeatType TEXT NOT NULL DEFAULT 'NONE',
    repeatDays TEXT NOT NULL DEFAULT '',
    description TEXT NOT NULL DEFAULT '',
    hide INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    parentId INTEGER,                       -- NULL = root task
    blockStatus INTEGER AS Boolean NOT NULL DEFAULT 0,
    priority INTEGER,
    dueDateAndTime INTEGER,
    frequencyNumber TEXT,
    endDate INTEGER,
    repeatAfterDone INTEGER AS Boolean NOT NULL DEFAULT 0,
    skipStatus INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (parentId) REFERENCES Task(id) ON DELETE SET NULL
);

CREATE TABLE BlockedTask (
    task_id    INTEGER NOT NULL,
    blockedBy_id INTEGER NOT NULL,
    PRIMARY KEY (task_id, blockedBy_id),
    FOREIGN KEY (task_id)    REFERENCES Task(id) ON DELETE CASCADE,
    FOREIGN KEY (blockedBy_id) REFERENCES Task(id) ON DELETE CASCADE
);

getBlockedTasks:
SELECT Task.*
FROM Task
JOIN BlockedTask ON Task.id = BlockedTask.task_id
WHERE BlockedTask.blockedBy_id = ?;

getBlockedByTasks:
SELECT Task.*
FROM Task
JOIN BlockedTask ON Task.id = BlockedTask.blockedBy_id
WHERE BlockedTask.task_id = ?;


blockTask:
INSERT OR IGNORE INTO BlockedTask(task_id, blockedBy_id)
VALUES (
?,
?
);

removeAllBlocks:
DELETE FROM BlockedTask WHERE task_id = ?;

updateTask:
UPDATE Task
SET
    title = ?,
    done = ?,
    repeatType = ?,
    repeatDays = ?,
    description = ?,
    hide = ?,
    parentId = ?,
    blockStatus = ?,
    priority = ?,
    frequencyNumber = ?,
    dueDateAndTime = ?,
    repeatAfterDone = ?,
    skipStatus = ?,
    endDate = ?
WHERE id = ?;

getTaskById:
SELECT * FROM Task
WHERE id = ?;

getLastRowInsertId:
SELECT last_insert_rowid();

saveTask:
INSERT INTO Task(
    title,
    done,
    repeatType,
    repeatDays,
    description,
    hide,
    createdAt,
    parentId,
    blockStatus,
    priority,
    frequencyNumber,
    dueDateAndTime,
    repeatAfterDone,
    skipStatus,
    endDate
)
VALUES (
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?
);

getAll:
SELECT * FROM Task;

getAllBlockers:
SELECT * FROM BlockedTask;

