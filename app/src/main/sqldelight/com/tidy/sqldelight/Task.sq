areAllChildrenDone:
SELECT NOT EXISTS (
    SELECT 1 FROM Task WHERE parentId = ? AND done != 1
);

updateDoneStatus:
UPDATE Task SET done = ? WHERE id = ?;

getParentId:
SELECT parentId FROM Task WHERE id = ?;

updateTaskAndDescendantsHideStatus:
WITH RECURSIVE descendants(id) AS (
    SELECT id FROM Task WHERE id = :taskId
    UNION ALL
    SELECT t.id FROM Task t
    INNER JOIN descendants d ON t.parentId = d.id
)
UPDATE Task SET hide = :hide WHERE id IN (SELECT id FROM descendants);

updateTaskAndDescendantsDoneStatus:
WITH RECURSIVE descendants(id) AS (
    SELECT id FROM Task WHERE id = :taskId
    UNION ALL
    SELECT t.id FROM Task t
    INNER JOIN descendants d ON t.parentId = d.id
)
UPDATE Task SET done = :done WHERE id IN (SELECT id FROM descendants);

resetSkippedTasks:
UPDATE Task SET hide = 0 AND skipStatus = 0 WHERE hide = 1 AND skipStatus = 1;

getNonDoneDailyTasksWithDueDate:
SELECT * FROM Task WHERE done = 0 AND hide = 0  AND dueDateAndTime != NULL AND repeatType = ? ;

getAllDescendants:
WITH RECURSIVE descendants(id) AS (
    SELECT id FROM Task WHERE parentId = :taskId
    UNION ALL
    SELECT t.id
    FROM Task t
    JOIN descendants d ON t.parentId = d.id
)
SELECT id FROM Task WHERE id IN (SELECT id FROM descendants);